<Window x:Class="RocketRP.TrainingGUI.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:RocketRP.TrainingGUI.ViewModels"
		Title="RocketRP - Training Pack" Width="920" Height="760">
	<Window.Resources>
		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,3,8,3" />
		</Style>
		<Style x:Key="FieldBox" TargetType="TextBox">
			<Setter Property="Width" Value="110" />
			<Setter Property="Margin" Value="0,3,24,3" />
		</Style>

		<!-- Placement of the ball or of the car: location, rotation and start speed. -->
		<DataTemplate x:Key="ArchetypeTemplate" DataType="{x:Type vm:ArchetypeViewModel}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="X (largeur)" />
				<TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding X}" />
				<TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Y (longueur)" />
				<TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Y}" />
				<TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Z (hauteur)" />
				<TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding Z}" />

				<TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Pitch (haut / bas)" />
				<TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldBox}" Text="{Binding Pitch}" />
				<TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Yaw (gauche / droite)" />
				<TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldBox}" Text="{Binding Yaw}" />
				<TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Vitesse (cm/s)" />
				<TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldBox}" Text="{Binding Speed}" />
			</Grid>
		</DataTemplate>

		<!-- Editor of the selected level. -->
		<DataTemplate DataType="{x:Type vm:RoundViewModel}">
			<StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
					<TextBlock Style="{StaticResource FieldLabel}" FontWeight="Bold" Text="{Binding DisplayName}" />
					<TextBlock Style="{StaticResource FieldLabel}" Margin="16,3,8,3" Text="Temps limite (s)" />
					<TextBox Width="50" VerticalAlignment="Center" Text="{Binding TimeLimit}" />
				</StackPanel>
				<GroupBox Header="Balle" Padding="8,4">
					<ContentControl Content="{Binding Ball}" ContentTemplate="{StaticResource ArchetypeTemplate}" />
				</GroupBox>
				<GroupBox Header="Voiture" Padding="8,4" Margin="0,8,0,0">
					<ContentControl Content="{Binding Car}" ContentTemplate="{StaticResource ArchetypeTemplate}" />
				</GroupBox>
				<TextBlock Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"
						   Text="La caméra de prévisualisation du niveau est conservée telle quelle : elle n'a aucune incidence en jeu." />
			</StackPanel>
		</DataTemplate>
	</Window.Resources>

	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="120" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<Button Grid.Row="0" Grid.Column="0" Content="Importer un .Tem / .json..." Padding="10,4" Command="{Binding ImportCommand}" />
		<TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,0" VerticalAlignment="Center"
				   TextTrimming="CharacterEllipsis" Text="{Binding JsonPath, TargetNullValue=Aucun fichier chargé}" />

		<TextBlock Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" VerticalAlignment="Center" Text="Nom du JSON" />
		<TextBox Grid.Row="1" Grid.Column="1" Margin="10,12,0,0" VerticalAlignment="Center" IsEnabled="{Binding HasJson}"
				 Text="{Binding JsonFileName, UpdateSourceTrigger=PropertyChanged}" />
		<Button Grid.Row="1" Grid.Column="2" Margin="10,12,0,0" Padding="10,4" Content="Renommer" Command="{Binding RenameCommand}" />

		<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
			<Button Padding="10,6" Content="Enregistrer le JSON" Command="{Binding SaveCommand}" />
			<Button Padding="10,6" Margin="8,0,0,0" Content="Convertir le JSON en .Tem" Command="{Binding ConvertToTemCommand}" />
		</StackPanel>

		<GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Header="Pack" Padding="8,4" Margin="0,12,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Titre" />
				<TextBox Grid.Row="0" Grid.Column="1" Width="300" Margin="0,3" VerticalAlignment="Center"
						 IsEnabled="{Binding HasJson}" Text="{Binding PackName}" />

				<TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Map" />
				<ComboBox Grid.Row="1" Grid.Column="1" Width="300" Margin="0,3" VerticalAlignment="Center"
						  IsEnabled="{Binding IsMapUnlocked}" ItemsSource="{Binding AvailableMaps}" SelectedItem="{Binding PackMap}" />
				<StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="12,3,0,3">
					<CheckBox VerticalAlignment="Center" Content="Autoriser la modification de la map"
							  IsEnabled="{Binding HasJson}" IsChecked="{Binding IsMapUnlocked}" />
					<TextBlock Style="{StaticResource FieldLabel}" Margin="12,0,0,0" Foreground="DarkRed" TextWrapping="Wrap"
							   Text="Une map incompatible peut faire planter le jeu." />
				</StackPanel>
			</Grid>
		</GroupBox>

		<ListBox Grid.Row="4" Grid.Column="0" Width="150" Margin="0,12,0,0" ItemsSource="{Binding Rounds}"
				 SelectedItem="{Binding SelectedRound}" DisplayMemberPath="DisplayName" />
		<ScrollViewer Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,12,0,0" VerticalScrollBarVisibility="Auto">
			<ContentControl Content="{Binding SelectedRound}" />
		</ScrollViewer>

		<TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" IsReadOnly="True"
				 FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
				 Text="{Binding Log, Mode=OneWay}" />
	</Grid>
</Window>
