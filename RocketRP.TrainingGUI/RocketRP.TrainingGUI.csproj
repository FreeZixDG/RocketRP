<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>RocketRP.TrainingGUI</RootNamespace>
    <AssemblyName>RocketRP.TrainingGUI</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>FreeZixDG</Authors>
    <Product>RocketRP Training GUI</Product>
    <Description>Graphical editor and converter for Rocket League custom training packs.</Description>
    <ApplicationIcon>..\icons\RocketRP.TrainingGUI.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocketRP\RocketRP.csproj" />
  </ItemGroup>

</Project>
